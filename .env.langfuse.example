# Local self-hosted Langfuse configuration for overrides/compose.langfuse.yaml.
# Prefer running ./setup-ai-observability.sh instead of copying this file so
# every password and key is generated securely. Never use these placeholders.

LANGFUSE_VERSION=3.212.0
LANGFUSE_CLICKHOUSE_IMAGE=docker.io/clickhouse/clickhouse-server:26.6.1.1193
LANGFUSE_MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:8230f06574280781ea6ad45e27962db60175b18e4a43dd54c19012feb5438174
LANGFUSE_REDIS_VERSION=7.4.9
LANGFUSE_POSTGRES_VERSION=17.10

LANGFUSE_PORT=3000
LANGFUSE_MINIO_PORT=9090
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_MINIO_PUBLIC_URL=http://localhost:9090

LANGFUSE_POSTGRES_USER=langfuse
LANGFUSE_POSTGRES_PASSWORD=replace-with-random-hex
LANGFUSE_POSTGRES_DB=langfuse
LANGFUSE_DATABASE_URL=postgresql://langfuse:replace-with-random-hex@langfuse-postgres:5432/langfuse
LANGFUSE_SALT=replace-with-random-hex
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-characters
LANGFUSE_NEXTAUTH_SECRET=replace-with-random-hex
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-random-hex
LANGFUSE_REDIS_AUTH=replace-with-random-hex
LANGFUSE_MINIO_ROOT_USER=langfuse
LANGFUSE_MINIO_ROOT_PASSWORD=replace-with-random-hex

LANGFUSE_INIT_ORG_ID=myapp
LANGFUSE_INIT_ORG_NAME=MyApp
LANGFUSE_INIT_PROJECT_ID=myapp-ai
LANGFUSE_INIT_PROJECT_NAME=MyApp-AI-Copilot
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-replace-with-random-value
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-replace-with-random-value
LANGFUSE_INIT_USER_EMAIL=admin@myapp.local
LANGFUSE_INIT_USER_NAME=MyApp-AI-Admin
LANGFUSE_INIT_USER_PASSWORD=replace-with-random-password

LANGFUSE_TELEMETRY_ENABLED=false
MYAPP_AI_LANGFUSE_ENVIRONMENT=development
MYAPP_AI_LANGFUSE_RELEASE=local
MYAPP_AI_LANGFUSE_CAPTURE_CONTENT=0
MYAPP_AI_LANGFUSE_TIMEOUT_SECONDS=5
