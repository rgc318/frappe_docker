ERPNEXT_VERSION=v16.18.3

# internal: use compose.noproxy.yaml for LAN/debug access
# https: use compose.https.yaml for public HTTPS access
STAGING_MODE=internal

CUSTOM_IMAGE=ghcr.io/<github-owner>/myapp-erpnext
CUSTOM_TAG=staging-latest
MYAPP_AI_IMAGE=ghcr.io/<github-owner>/myapp-ai
MYAPP_AI_TAG=staging-latest
PULL_POLICY=always

DB_PASSWORD=changeit
DB_PASSWORD_SECRETS_FILE=
DB_HOST=
DB_PORT=

REDIS_CACHE=
REDIS_QUEUE=

LETSENCRYPT_EMAIL=ops@example.com

FRAPPE_SITE_NAME_HEADER=

# Optional explicit URL for health checks.
# Example:
# STAGING_BASE_URL=https://staging.example.com
# For internal mode, you can also set:
# STAGING_BASE_URL=http://127.0.0.1:8080

HTTP_PUBLISH_PORT=8080
HTTPS_PUBLISH_PORT=8443

UPSTREAM_REAL_IP_ADDRESS=
UPSTREAM_REAL_IP_HEADER=
UPSTREAM_REAL_IP_RECURSIVE=

PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

SITES_RULE=Host(`staging.example.com`)
NGINX_PROXY_HOSTS=staging.example.com

FRAPPE_BRANCH=v16.18.3
FRAPPE_PATH=https://github.com/frappe/frappe

# AI Orchestrator and Gateway. Replace every placeholder before deployment.
MYAPP_AI_LITELLM_BASE_URL=https://litellm.example.internal
MYAPP_AI_LITELLM_API_KEY=replace-with-litellm-key
MYAPP_AI_MODEL=opencode-deepseek-v4-flash
MYAPP_AI_FALLBACK_MODELS=gpt-5.6-luna,nvap-gpt-5.6-terra
MYAPP_AI_REASONING_EFFORT=none
MYAPP_AI_SERVICE_TOKEN=replace-with-a-random-256-bit-token
MYAPP_AI_ORCHESTRATOR_URL=http://ai-orchestrator:4010
MYAPP_AI_AGENT_RUNTIME_ENABLED=1
MYAPP_AI_FRAPPE_BASE_URL=http://backend:8000
MYAPP_AI_FRAPPE_SITE_HOST=staging.example.com
MYAPP_AI_ENVIRONMENT=staging
MYAPP_AI_RETENTION_DAYS=30
MYAPP_AI_REDIS_URL=redis://redis-cache:6379/0
MYAPP_AI_REDIS_KEY_PREFIX=myapp-ai:staging

# Product vector search. Keep disabled until the Embedding alias and collection pass smoke tests.
MYAPP_AI_EMBEDDING_MODEL=erp-embedding
MYAPP_AI_QDRANT_URL=http://ai-vector:6333
MYAPP_AI_QDRANT_COLLECTION=myapp-products-v1
MYAPP_AI_QDRANT_ALIAS=myapp-products-live
MYAPP_AI_VECTOR_EXCLUDED_ITEM_PREFIXES=HTTP-
MYAPP_AI_VECTOR_SEARCH_ENABLED=0

# Governed reports must be generated from the exact AI image revision, Prompt manifest,
# tool manifest, model aliases and dataset fingerprint before an Agent policy can publish.
MYAPP_AI_GOVERNANCE_OFFLINE_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/offline-gate.json
MYAPP_AI_GOVERNANCE_LIVE_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/live-gate.json
MYAPP_AI_GOVERNANCE_EMBEDDING_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/embedding-gate.json

# Optional external Langfuse. Leave all three values empty to keep observability disabled/fail-open.
MYAPP_AI_LANGFUSE_HOST=
MYAPP_AI_LANGFUSE_PUBLIC_KEY=
MYAPP_AI_LANGFUSE_SECRET_KEY=
MYAPP_AI_LANGFUSE_ENVIRONMENT=staging
MYAPP_AI_LANGFUSE_RELEASE=staging
MYAPP_AI_LANGFUSE_CAPTURE_CONTENT=0
MYAPP_AI_LANGFUSE_TIMEOUT_SECONDS=5
MYAPP_AI_LANGFUSE_QUEUE_CAPACITY=1000
MYAPP_AI_LANGFUSE_BATCH_SIZE=20
MYAPP_AI_LANGFUSE_FLUSH_INTERVAL_SECONDS=0.25
MYAPP_AI_LANGFUSE_MAX_RETRIES=2
MYAPP_AI_LANGFUSE_SHUTDOWN_TIMEOUT_SECONDS=5
