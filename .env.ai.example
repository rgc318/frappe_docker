# Copy to .env.ai.local and keep the local file out of Git.
MYAPP_AI_LITELLM_BASE_URL=http://192.168.31.229:4000
MYAPP_AI_LITELLM_API_KEY=replace-with-litellm-key
MYAPP_AI_MODEL=opencode-deepseek-v4-flash
MYAPP_AI_REASONING_EFFORT=none
MYAPP_AI_SERVICE_TOKEN=replace-with-a-random-service-token
MYAPP_AI_ORCHESTRATOR_URL=http://ai-orchestrator:4010
MYAPP_AI_FRAPPE_BASE_URL=http://backend:8000
MYAPP_AI_FRAPPE_SITE_HOST=localhost
MYAPP_AI_ENVIRONMENT=development
MYAPP_AI_POLICY_CACHE_TTL_SECONDS=30
MYAPP_AI_TIMEOUT_SECONDS=60
MYAPP_AI_RETENTION_DAYS=30

# Distributed runtime governance. Required when a published policy configures RPM/TPM,
# concurrency or budgets. If unavailable, governed limits fail closed instead of falling
# back to per-process counters.
MYAPP_AI_REDIS_URL=redis://redis-cache:6379/0
MYAPP_AI_REDIS_KEY_PREFIX=myapp-ai:development
MYAPP_AI_CIRCUIT_FAILURE_THRESHOLD=3
MYAPP_AI_CIRCUIT_FAILURE_WINDOW_SECONDS=60
MYAPP_AI_CIRCUIT_OPEN_SECONDS=60
MYAPP_AI_CONCURRENCY_LEASE_SECONDS=180
MYAPP_AI_HTTP_MAX_CONNECTIONS=200
MYAPP_AI_HTTP_MAX_KEEPALIVE_CONNECTIONS=50
MYAPP_AI_HTTP_KEEPALIVE_EXPIRY_SECONDS=30
MYAPP_AI_HTTP_CONNECT_TIMEOUT_SECONDS=5
MYAPP_AI_HTTP_POOL_TIMEOUT_SECONDS=2
MYAPP_AI_CHAT_CONCURRENCY=100
MYAPP_AI_STRUCTURED_CONCURRENCY=20
MYAPP_AI_EMBEDDING_CONCURRENCY=8

# Product semantic search. Use LiteLLM capability aliases instead of provider-specific model names.
MYAPP_AI_EMBEDDING_MODEL=erp-embedding
MYAPP_AI_QDRANT_URL=http://ai-vector:6333
MYAPP_AI_QDRANT_COLLECTION=myapp-products-v1
# Production search and incremental writes should use this stable alias after it is initialized.
MYAPP_AI_QDRANT_ALIAS=myapp-products-live
MYAPP_AI_VECTOR_TIMEOUT_SECONDS=15
# Comma-separated literal item-code prefixes excluded from indexing and semantic candidates.
# Start with explicit test prefixes only; excluded ERP Items and transaction history remain intact.
MYAPP_AI_VECTOR_EXCLUDED_ITEM_PREFIXES=HTTP-
# Enable only after the configured embedding alias passes the vector smoke test.
MYAPP_AI_VECTOR_SEARCH_ENABLED=0

# Governed release evidence. Reports must be redacted full-gate artifacts generated by the
# fixed evaluation or embedding quality runner and copied into ./ai-governance-reports.
# Missing, partial, failed, wrong-model or malformed reports block policy publication.
MYAPP_AI_GOVERNANCE_LIVE_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/live-gate.json
MYAPP_AI_GOVERNANCE_EMBEDDING_GATE_REPORT_PATH=/var/lib/myapp-ai/governance-reports/embedding-gate.json

# Optional external Langfuse observability. Leave keys empty to disable without affecting AI requests.
# For the bundled local v3.212.0 stack, run ./setup-ai-observability.sh and use
# overrides/compose.langfuse.yaml; the override injects its generated project keys.
MYAPP_AI_LANGFUSE_HOST=http://langfuse.example.internal
MYAPP_AI_LANGFUSE_PUBLIC_KEY=
MYAPP_AI_LANGFUSE_SECRET_KEY=
MYAPP_AI_LANGFUSE_ENVIRONMENT=development
MYAPP_AI_LANGFUSE_RELEASE=
MYAPP_AI_LANGFUSE_CAPTURE_CONTENT=0
MYAPP_AI_LANGFUSE_TIMEOUT_SECONDS=5
MYAPP_AI_LANGFUSE_QUEUE_CAPACITY=1000
MYAPP_AI_LANGFUSE_BATCH_SIZE=20
MYAPP_AI_LANGFUSE_FLUSH_INTERVAL_SECONDS=0.25
MYAPP_AI_LANGFUSE_MAX_RETRIES=2
MYAPP_AI_LANGFUSE_SHUTDOWN_TIMEOUT_SECONDS=5

# Billable HTTP AI regression tests remain disabled unless explicitly enabled.
# MYAPP_HTTP_ENABLE_AI_TESTS=1
