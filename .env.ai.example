# Copy to .env.ai.local and keep the local file out of Git.
MYAPP_AI_LITELLM_BASE_URL=http://192.168.31.229:4000
MYAPP_AI_LITELLM_API_KEY=replace-with-litellm-key
MYAPP_AI_MODEL=opencode-deepseek-v4-flash
MYAPP_AI_REASONING_EFFORT=none
MYAPP_AI_SERVICE_TOKEN=replace-with-a-random-service-token
MYAPP_AI_ORCHESTRATOR_URL=http://ai-orchestrator:4010
MYAPP_AI_TIMEOUT_SECONDS=60
MYAPP_AI_RETENTION_DAYS=30

# Product semantic search. Use LiteLLM capability aliases instead of provider-specific model names.
MYAPP_AI_EMBEDDING_MODEL=erp-embedding
MYAPP_AI_QDRANT_URL=http://ai-vector:6333
MYAPP_AI_QDRANT_COLLECTION=myapp-products-v1
MYAPP_AI_VECTOR_TIMEOUT_SECONDS=15
# Enable only after the configured embedding alias passes the vector smoke test.
MYAPP_AI_VECTOR_SEARCH_ENABLED=0

# Optional external Langfuse observability. Leave keys empty to disable without affecting AI requests.
# For the bundled local v3.212.0 stack, run ./setup-ai-observability.sh and use
# overrides/compose.langfuse.yaml; the override injects its generated project keys.
MYAPP_AI_LANGFUSE_HOST=http://langfuse.example.internal
MYAPP_AI_LANGFUSE_PUBLIC_KEY=
MYAPP_AI_LANGFUSE_SECRET_KEY=
MYAPP_AI_LANGFUSE_ENVIRONMENT=development
MYAPP_AI_LANGFUSE_RELEASE=
MYAPP_AI_LANGFUSE_CAPTURE_CONTENT=0
MYAPP_AI_LANGFUSE_TIMEOUT_SECONDS=5

# Billable HTTP AI regression tests remain disabled unless explicitly enabled.
# MYAPP_HTTP_ENABLE_AI_TESTS=1
