ARG FRAPPE_BRANCH=v16.18.3

FROM frappe/build:${FRAPPE_BRANCH} AS builder

ARG FRAPPE_BRANCH=v16.18.3
ARG FRAPPE_PATH=https://github.com/frappe/frappe
ARG ERPNEXT_REF=v16.18.3
ARG MYAPP_REF=main
ARG MYAPP_REVISION=unversioned
ARG APPS_JSON_BASE64
ARG CACHE_BUST=manual
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY

USER root

RUN git config --global http.version HTTP/1.1 \
    && if [ -n "${HTTP_PROXY}" ]; then git config --global http.proxy "${HTTP_PROXY}"; fi \
    && if [ -n "${HTTPS_PROXY}" ]; then git config --global https.proxy "${HTTPS_PROXY}"; fi

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y redis-server \
    && rm -rf /var/lib/apt/lists/*

RUN if [ -n "${APPS_JSON_BASE64}" ]; then \
    mkdir -p /opt/frappe && echo "${APPS_JSON_BASE64}" | base64 -d > /opt/frappe/apps.json; \
  fi

USER frappe

RUN --mount=type=cache,target=/home/frappe/.cache/uv,uid=1000,gid=1000 \
  --mount=type=cache,target=/home/frappe/.cache/yarn,uid=1000,gid=1000 \
  set -eu; \
  export UV_LINK_MODE=copy; \
  export APP_INSTALL_ARGS=""; \
  echo "Cache bust: ${CACHE_BUST}" && \
  if [ -n "${APPS_JSON_BASE64}" ]; then \
    export APP_INSTALL_ARGS="--apps_path=/opt/frappe/apps.json"; \
  fi; \
  attempt=1; \
  until bench init ${APP_INSTALL_ARGS} \
      --frappe-branch=${FRAPPE_BRANCH} \
      --frappe-path=${FRAPPE_PATH} \
      --no-procfile \
      --no-backups \
      --skip-redis-config-generation \
      --skip-assets \
      /home/frappe/frappe-bench; do \
    if [ "${attempt}" -ge 3 ]; then \
      echo "bench init failed after ${attempt} attempts" >&2; \
      exit 1; \
    fi; \
    rm -rf /home/frappe/frappe-bench; \
    attempt=$((attempt + 1)); \
    echo "Retrying bench init (${attempt}/3) after transient dependency download failure..." >&2; \
    sleep $((attempt * 5)); \
  done; \
  cd /home/frappe/frappe-bench; \
  actual_myapp_revision="$(git -C apps/myapp rev-parse HEAD)"; \
  if [ "${MYAPP_REVISION}" != "unversioned" ] && [ "${actual_myapp_revision}" != "${MYAPP_REVISION}" ]; then \
    echo "myapp source drift: expected ${MYAPP_REVISION}, got ${actual_myapp_revision}" >&2; \
    exit 1; \
  fi; \
  echo "{}" > sites/common_site_config.json; \
  uv pip install \
    --upgrade \
    --python /home/frappe/frappe-bench/env/bin/python \
    -e apps/frappe \
    -e apps/erpnext \
    -e apps/myapp; \
  redis-server \
    --bind 127.0.0.1 \
    --port 13311 \
    --save "" \
    --appendonly no \
    --daemonize yes \
    --dir /tmp \
    --pidfile /tmp/myapp-build-redis.pid \
    --logfile /tmp/myapp-build-redis.log; \
  trap 'redis-cli -p 13311 shutdown nosave >/dev/null 2>&1 || true' EXIT; \
  redis-cli -p 13311 ping | grep -q PONG; \
  bench build; \
  redis-cli -p 13311 shutdown nosave; \
  trap - EXIT; \
  ./env/bin/python -c "import importlib.metadata as md; import frappe, erpnext, jwt, rgc_backend_kit, xlsxwriter, myapp; print('frappe', md.version('frappe')); print('erpnext', md.version('erpnext')); print('PyJWT', jwt.__version__); print('rgc-backend-kit', md.version('rgc-backend-kit')); print('xlsxwriter', md.version('XlsxWriter')); print('myapp', md.version('myapp'))"; \
  ./env/bin/pip check; \
  find apps -mindepth 1 -path "*/.git" | xargs rm -fr

FROM frappe/base:${FRAPPE_BRANCH} AS backend

ARG FRAPPE_BRANCH=v16.18.3
ARG ERPNEXT_REF=v16.18.3
ARG MYAPP_REF=main
ARG MYAPP_REVISION=unversioned
ARG RELEASE_ID=unversioned
ARG CACHE_BUST=manual

LABEL org.rgc.frappe_ref="${FRAPPE_BRANCH}" \
  org.rgc.erpnext_ref="${ERPNEXT_REF}" \
  org.rgc.myapp_ref="${MYAPP_REF}" \
  org.rgc.myapp_revision="${MYAPP_REVISION}" \
  org.rgc.release_id="${RELEASE_ID}" \
  org.rgc.cache_bust="${CACHE_BUST}"

USER root

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
    fontconfig \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

USER frappe

COPY --from=builder --chown=frappe:frappe /home/frappe/frappe-bench /home/frappe/frappe-bench

USER root

RUN mkdir -p /home/frappe/frappe-bench/logs \
    && chown frappe:frappe /home/frappe/frappe-bench/logs \
    && if [ ! -e /home/frappe/logs ]; then \
      ln -s /home/frappe/frappe-bench/logs /home/frappe/logs; \
    fi

USER frappe

RUN test -d /home/frappe/logs \
    && test -w /home/frappe/logs

WORKDIR /home/frappe/frappe-bench

VOLUME [ \
  "/home/frappe/frappe-bench/sites", \
  "/home/frappe/frappe-bench/sites/assets", \
  "/home/frappe/frappe-bench/logs" \
]

CMD [ \
  "/home/frappe/frappe-bench/env/bin/gunicorn", \
  "--chdir=/home/frappe/frappe-bench/sites", \
  "--bind=0.0.0.0:8000", \
  "--threads=4", \
  "--workers=2", \
  "--worker-class=gthread", \
  "--worker-tmp-dir=/dev/shm", \
  "--timeout=120", \
  "--preload", \
  "frappe.app:application" \
]
